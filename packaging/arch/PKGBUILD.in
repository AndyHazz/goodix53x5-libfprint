# Maintainer: AndyHazz <andy.nmc@gmail.com>
# Generated by packaging/arch/make-aur-package.sh from @REPOSITORY@ release v@VERSION@.

pkgname=libfprint-goodix53x5
epoch=1
pkgver=@PKGVER@
_version=@VERSION@
pkgrel=1
pkgdesc="Goodix 53x5 Milan fingerprint driver (27c6:5335/5385/5395) with matching fprintd and PAM module"
arch=('x86_64')
url="https://github.com/@REPOSITORY@"
license=('LGPL-2.1-or-later' 'GPL-2.0-or-later')
depends=('dbus' 'glib2' 'glibc' 'libdeflate' 'libgusb' 'openssl' 'pam' 'polkit'
         'systemd-libs')
makedepends=('git' 'glib2-devel' 'meson' 'ninja' 'perl' 'pkgconf' 'python' 'systemd')
provides=('fprintd=1.94.5')
conflicts=('fprintd')
backup=('etc/fprintd.conf')
options=('!debug')
install="$pkgname.install"
source=("https://github.com/@REPOSITORY@/releases/download/v$_version/goodix53x5-libfprint-$_version.tar.xz")
sha256sums=('@SHA256@')

build() {
  cd "goodix53x5-libfprint-$_version"
  rm -rf -- "$srcdir/milan-stack" "$srcdir/stage"
  # The stack builder verifies, patches, builds and tests the pinned libfprint
  # and fprintd from the archive, then stages the package payload.
  GOODIX53X5_DEBUG=0 GOODIX_MILAN_STACK_ROOT="$srcdir/milan-stack" \
    scripts/build-milan-stack-local.sh --package-root "$srcdir/stage"
}

package() {
  cp -a -- "$srcdir/stage/." "$pkgdir/"
  cd "goodix53x5-libfprint-$_version/sources"
  install -Dm644 libfprint/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING.libfprint"
  install -Dm644 fprintd/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING.fprintd"
}
