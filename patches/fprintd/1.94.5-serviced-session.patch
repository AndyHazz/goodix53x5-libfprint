+/* One attempt at enumeration; a failed open is retried only by a claim. */
+void
+fprint_device_open_unclaimed (FprintDevice *rdev)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+
+  if (priv->power_pending || priv->current_action != ACTION_NONE ||
+      fp_device_is_open (priv->dev))
+    return;
+
+  priv->current_action = ACTION_OPEN;
+  g_object_notify (G_OBJECT (rdev), "busy");
+  fp_device_open (priv->dev, NULL, (GAsyncReadyCallback) dev_open_cb, g_object_ref (rdev));
