+static void
+fail_deferred_start (FprintDevice *rdev,
+                     const char   *message)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+
+  g_autoptr(GDBusMethodInvocation) invocation = g_steal_pointer (&priv->deferred_start);
+
+  if (invocation)
+    g_dbus_method_invocation_return_error_literal (invocation,
+                                                   FPRINT_ERROR, FPRINT_ERROR_INTERNAL,
+                                                   message);
+}
