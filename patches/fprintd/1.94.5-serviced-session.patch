+/* End the claim's action: cancel a running one and wait for it, or unset a
+ * completed verify/identify/enroll that was never stopped explicitly. */
+static void
+stop_current_action (FprintDevice *rdev)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+
+  fail_deferred_start (rdev, "Claim released before start");
+  if (!priv->current_cancellable)
+    {
+      switch (priv->current_action)
+        {
+        case ACTION_VERIFY:
+        case ACTION_IDENTIFY:
+        case ACTION_ENROLL:
+          priv->current_action = ACTION_NONE;
+          break;
+
+        default:
+          break;
+        }
+      return;
+    }
+
+  if (priv->current_action == ACTION_ENROLL)
+    g_warning ("Enrollment was in progress, stopping it");
+  else if (priv->current_action == ACTION_IDENTIFY ||
+           priv->current_action == ACTION_VERIFY)
+    g_warning ("Verification was in progress, stopping it");
+  else if (priv->current_action == ACTION_DELETE)
+    g_warning ("Deletion was in progress, stopping it");
+
+  g_cancellable_cancel (priv->current_cancellable);
+  while (priv->current_action != ACTION_NONE)
+    g_main_context_iteration (NULL, TRUE);
+}
+
+/* Daemon exit or device removal: end the claim, then close the retained
+ * hardware for real. libfprint withholds FpContext::device-removed until a
+ * removed device has been closed. */
+void
+fprint_device_shutdown (FprintDevice *rdev)
+{
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+
+  g_autoptr(GError) error = NULL;
 
-  fprint_dbus_device_complete_release (FPRINT_DBUS_DEVICE (rdev),
-                                       invocation);
+  stop_current_action (rdev);
+  while (priv->current_action == ACTION_OPEN)
+    g_main_context_iteration (NULL, TRUE);
+  session_data_set_new (priv, NULL, NULL);
+  if (fp_device_is_open (priv->dev) &&
+      !fp_device_close_sync (priv->dev, NULL, &error) &&
+      !g_error_matches (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_REMOVED))
+    g_warning ("Error closing device %d: %s", priv->id, error->message);
 }
 
