diff --git a/libfprint/fpi-device.c b/libfprint/fpi-device.c
index a1be30c0e6c5cdf4d68bf6cbb6061b66c0042561..2d2d32a8c1fb82b344597e85d03fb3c17c00f020 100644
--- a/libfprint/fpi-device.c
+++ b/libfprint/fpi-device.c
@@ -1615,7 +1615,11 @@ fpi_device_suspend (FpDevice *device)
   switch (priv->current_action)
     {
     case FPI_DEVICE_ACTION_NONE:
-      fpi_device_suspend_complete (device, NULL);
+      /* An open Goodix device keeps servicing its hardware while idle. */
+      if (priv->is_open && FP_DEVICE_GET_CLASS (device)->suspend)
+        FP_DEVICE_GET_CLASS (device)->suspend (device);
+      else
+        fpi_device_suspend_complete (device, NULL);
       break;
 
     case FPI_DEVICE_ACTION_ENROLL:
@@ -1642,9 +1646,11 @@ fpi_device_suspend (FpDevice *device)
     case FPI_DEVICE_ACTION_DELETE:
     case FPI_DEVICE_ACTION_LIST:
     case FPI_DEVICE_ACTION_CLEAR_STORAGE:
+      /* Dispatch again once the short action completed, so the driver
+       * still quiesces a device that this action just opened. */
       g_signal_connect_object (priv->current_task,
                                "notify::completed",
-                               G_CALLBACK (complete_suspend_resume_task),
+                               G_CALLBACK (fpi_device_suspend),
                                device,
                                G_CONNECT_SWAPPED);
 
@@ -1660,7 +1666,10 @@ fpi_device_resume (FpDevice *device)
   switch (priv->current_action)
     {
     case FPI_DEVICE_ACTION_NONE:
-      fpi_device_resume_complete (device, NULL);
+      if (priv->is_open && FP_DEVICE_GET_CLASS (device)->resume)
+        FP_DEVICE_GET_CLASS (device)->resume (device);
+      else
+        fpi_device_resume_complete (device, NULL);
       break;
 
     case FPI_DEVICE_ACTION_ENROLL:
