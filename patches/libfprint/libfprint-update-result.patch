+/**
+ * fpi_print_set_raw_data:
+ * @print: A raw #FpPrint
+ * @data: (transfer none): Replacement driver data
+ *
+ * Replaces the private driver data of an existing raw print.
+ */
+void
+fpi_print_set_raw_data (FpPrint  *print,
+                        GVariant *data)
+{
+  g_return_if_fail (FP_IS_PRINT (print));
+  g_return_if_fail (print->type == FPI_PRINT_RAW);
+  g_return_if_fail (data != NULL);
+
+  g_object_set (print, "fpi-data", data, NULL);
+}
