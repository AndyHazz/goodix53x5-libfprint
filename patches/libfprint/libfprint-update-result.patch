+typedef struct
+{
+  gboolean done;
+  gboolean success;
+  gboolean match;
+  gboolean updated;
+  GError  *complete_error;
+  GError  *error;
+} UpdateResultData;
+
+static void
+fake_device_verify_update_result (FpDevice *device)
+{
+  FpiDeviceFake *fake_dev = FPI_DEVICE_FAKE (device);
+  UpdateResultData *data = fake_dev->user_data;
+
+  fpi_device_verify_report (device, fake_dev->ret_result, NULL, NULL);
+  fpi_device_verify_complete_with_update (
+    device, TRUE, g_steal_pointer (&data->complete_error));
+}
+
+static void
+verify_update_result_cb (FpDevice     *device,
+                         GAsyncResult *result,
+                         gpointer      user_data)
+{
+  UpdateResultData *data = user_data;
+
+  data->success = fp_device_verify_finish_with_update (
+    device, result, &data->match, NULL, &data->updated, &data->error);
+  data->done = TRUE;
+}
+
+static void
+test_driver_verify_update_result (void)
+{
+  g_autoptr(FpAutoResetClass) dev_class = auto_reset_device_class ();
+  g_autoptr(FpAutoCloseDevice) device = NULL;
+  g_autoptr(FpPrint) enrolled_print = NULL;
+  FpiDeviceFake *fake_dev;
+  UpdateResultData data = { 0 };
+
+  dev_class->verify = fake_device_verify_update_result;
+  device = auto_close_fake_device_new ();
+  enrolled_print = make_fake_print_reffed (device, NULL);
+  fake_dev = FPI_DEVICE_FAKE (device);
+  fake_dev->user_data = &data;
+
+  fake_dev->ret_result = FPI_MATCH_SUCCESS;
+  fp_device_verify (device, enrolled_print, NULL, NULL, NULL, NULL,
+                    (GAsyncReadyCallback) verify_update_result_cb, &data);
+  while (!data.done)
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_true (data.success);
+  g_assert_true (data.match);
+  g_assert_true (data.updated);
+  g_assert_no_error (data.error);
+
+  memset (&data, 0, sizeof (data));
+  fake_dev->ret_result = FPI_MATCH_FAIL;
+  fp_device_verify (device, enrolled_print, NULL, NULL, NULL, NULL,
+                    (GAsyncReadyCallback) verify_update_result_cb, &data);
+  while (!data.done)
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_true (data.success);
+  g_assert_false (data.match);
+  g_assert_false (data.updated);
+  g_assert_no_error (data.error);
+
+  memset (&data, 0, sizeof (data));
+  data.complete_error = fpi_device_error_new (FP_DEVICE_ERROR_GENERAL);
+  fake_dev->ret_result = FPI_MATCH_SUCCESS;
+  fp_device_verify (device, enrolled_print, NULL, NULL, NULL, NULL,
+                    (GAsyncReadyCallback) verify_update_result_cb, &data);
+  while (!data.done)
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_false (data.success);
+  g_assert_false (data.updated);
+  g_assert_error (data.error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL);
+  g_clear_error (&data.error);
+}
+
 int
 main (int argc, char *argv[])
 {
